# Энэ файлыг .env.local болгон хуулж утгуудыг бөглөнө. .env.local нь git-д орохгүй.
# Vercel дээр Project Settings → Environment Variables-д ижил нэрээр нэмнэ.

# Supabase (нийтийн, хөтөч рүү очиж болно)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key — зөвхөн сервер (orders хүснэгтэд бичнэ). Dashboard → Project Settings → API Keys
SUPABASE_SECRET_KEY=

# Byl (https://byl.mn/docs/api) — зөвхөн сервер
BYL_TOKEN=
BYL_PROJECT_ID=
# Webhooks → endpoint-ийн дэлгэрэнгүй → Signing secret
BYL_WEBHOOK_SECRET=

# Заавал биш: success/cancel URL-ийн суурь хаяг (жш: https://tesla-relume-eta.vercel.app)
SITE_URL=
